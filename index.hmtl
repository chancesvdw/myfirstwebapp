<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Counter App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    keyframes: {
                        bump: {
                            '0%, 100%': { transform: 'scale(1)' },
                            '50%': { transform: 'scale(1.15)' },
                        },
                        pulseBg: {
                            '0%, 100%': { opacity: '0.2' },
                            '50%': { opacity: '0.5' },
                        }
                    },
                    animation: {
                        bump: 'bump 0.15s ease-in-out',
                        pulseBg: 'pulseBg 2s infinite',
                    }
                }
            }
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            user-select: none;
            -webkit-user-select: none;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .dark .glass-card {
            background: rgba(30, 41, 59, 0.7);
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="h-full bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors duration-300 flex flex-col justify-between overflow-x-hidden">

    <header class="w-full max-w-4xl mx-auto p-4 sm:p-6 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/30">
                <i class="fa-solid fa-calculator text-lg"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight">Counter Pro</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">Simple & Smart Tracker</p>
            </div>
        </div>

        <!-- Controls Header Toolbar -->
        <div class="flex items-center gap-2">
            <button id="soundToggleBtn" title="Toggle Sound Feedback" class="p-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition active:scale-95 border border-slate-200/60 dark:border-slate-700">
                <i id="soundIcon" class="fa-solid fa-volume-high text-base"></i>
            </button>
            <button id="themeToggleBtn" title="Toggle Theme" class="p-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition active:scale-95 border border-slate-200/60 dark:border-slate-700">
                <i id="themeIcon" class="fa-solid fa-moon text-base"></i>
            </button>
            <button id="shortcutsBtn" title="Keyboard Shortcuts" class="p-2.5 rounded-xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 shadow-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition active:scale-95 border border-slate-200/60 dark:border-slate-700">
                <i class="fa-solid fa-keyboard text-base"></i>
            </button>
        </div>
    </header>

    <main class="w-full max-w-4xl mx-auto px-4 py-2 flex-1 flex flex-col lg:flex-row items-stretch justify-center gap-6">
        
        <!-- Counter Primary Panel -->
        <div class="glass-card rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-xl flex-1 flex flex-col justify-between items-center relative overflow-hidden">
            
            <!-- Target Progress Header -->
            <div class="w-full mb-4">
                <div class="flex justify-between items-center text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
                    <span id="targetLabel">Goal Progress</span>
                    <span id="targetPercentage">0%</span>
                </div>
                <div class="w-full h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                    <div id="progressBar" class="h-full bg-gradient-to-r from-indigo-500 to-purple-600 w-0 transition-all duration-300"></div>
                </div>
            </div>

            <!-- Central Display -->
            <div class="my-auto py-8 text-center flex flex-col items-center justify-center">
                <div id="counterDisplay" class="text-7xl sm:text-9xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-all duration-150 inline-block">
                    0
                </div>
                <div id="goalBadge" class="hidden mt-3 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-700">
                    <i class="fa-solid fa-circle-check mr-1"></i> Target Reached!
                </div>
            </div>

            <div class="w-full space-y-4">
                <!-- Action Row -->
                <div class="grid grid-cols-2 gap-4">
                    <button id="decrementBtn" class="group relative py-5 rounded-2xl bg-slate-200/80 dark:bg-slate-800 hover:bg-rose-500 hover:text-white dark:hover:bg-rose-600 text-slate-800 dark:text-white font-bold text-3xl shadow-md transition-all duration-150 active:scale-95 flex items-center justify-center gap-2 border border-slate-300/50 dark:border-slate-700">
                        <i class="fa-solid fa-minus text-2xl"></i>
                        <span class="text-xs uppercase tracking-wider font-semibold opacity-80 group-hover:opacity-100 hidden sm:inline">Decrement</span>
                    </button>
                    <button id="incrementBtn" class="group relative py-5 rounded-2xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-3xl shadow-lg shadow-indigo-500/25 transition-all duration-150 active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-plus text-2xl"></i>
                        <span class="text-xs uppercase tracking-wider font-semibold opacity-90 group-hover:opacity-100 hidden sm:inline">Increment</span>
                    </button>
                </div>

                <!-- Secondary Control Bar -->
                <div class="flex items-center gap-2">
                    <button id="resetBtn" class="flex-1 py-2.5 px-4 rounded-xl bg-slate-200/60 dark:bg-slate-800/60 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Reset</span>
                    </button>
                    <button id="setValBtn" class="flex-1 py-2.5 px-4 rounded-xl bg-slate-200/60 dark:bg-slate-800/60 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-semibold transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-pen-to-square"></i>
                        <span>Set Value</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="w-full lg:w-80 flex flex-col gap-4">
            
            <!-- Quick Settings Panel -->
            <div class="glass-card rounded-3xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xl space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-2">
                    <i class="fa-solid fa-sliders"></i> Configuration
                </h2>

                <div class="space-y-3 text-sm">
                    <!-- Step Size -->
                    <div>
                        <label for="stepInput" class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Step Size</label>
                        <input type="number" id="stepInput" value="1" min="1" class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>

                    <!-- Target Goal -->
                    <div>
                        <label for="targetInput" class="block font-medium mb-1 text-slate-700 dark:text-slate-300">Target Goal</label>
                        <input type="number" id="targetInput" value="10" min="1" class="w-full px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>
            </div>

            <!-- History Panel -->
            <div class="glass-card rounded-3xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-xl flex-1 flex flex-col min-h-[200px]">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left"></i> History Log
                    </h2>
                    <button id="clearHistoryBtn" class="text-xs text-slate-400 hover:text-rose-500 transition">
                        Clear
                    </button>
                </div>

                <div id="historyList" class="flex-1 overflow-y-auto no-scrollbar space-y-2 max-h-48 lg:max-h-64 pr-1 text-xs">
                    <p id="emptyHistoryMsg" class="text-slate-400 text-center py-6">No activity recorded yet.</p>
                </div>
            </div>

        </div>

    </main>

    <footer class="w-full max-w-4xl mx-auto p-4 text-center text-xs text-slate-400">
        <p>Built with HTML, Tailwind CSS & JavaScript</p>
    </footer>

    <!-- Set Custom Value Modal -->
    <div id="customValModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 w-full max-w-xs shadow-2xl border border-slate-200 dark:border-slate-700 space-y-4">
            <h3 class="font-bold text-lg text-slate-900 dark:text-white">Set Counter Value</h3>
            <input type="number" id="customValInput" class="w-full px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Enter number...">
            <div class="flex gap-2">
                <button id="cancelModalBtn" class="flex-1 py-2 rounded-xl bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold text-sm">Cancel</button>
                <button id="saveModalBtn" class="flex-1 py-2 rounded-xl bg-indigo-600 text-white font-semibold text-sm shadow-md">Apply</button>
            </div>
        </div>
    </div>

    <!-- Shortcuts Modal -->
    <div id="shortcutsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 w-full max-w-sm shadow-2xl border border-slate-200 dark:border-slate-700 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-lg text-slate-900 dark:text-white">Keyboard Shortcuts</h3>
                <button id="closeShortcutsBtn" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="space-y-2 text-sm">
                <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                    <span class="text-slate-600 dark:text-slate-400">Increment</span>
                    <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-mono text-xs border border-slate-300 dark:border-slate-600">Space</kbd> or <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-mono text-xs border border-slate-300 dark:border-slate-600">↑</kbd>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                    <span class="text-slate-600 dark:text-slate-400">Decrement</span>
                    <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-mono text-xs border border-slate-300 dark:border-slate-600">↓</kbd>
                </div>
                <div class="flex justify-between py-1 border-b border-slate-100 dark:border-slate-700">
                    <span class="text-slate-600 dark:text-slate-400">Reset</span>
                    <kbd class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-700 font-mono text-xs border border-slate-300 dark:border-slate-600">R</kbd>
                </div>
            </div>
        </div>
    </div>

    <script>
        // State variables
        let count = 0;
        let step = 1;
        let target = 10;
        let soundEnabled = true;
        let history = [];

        // DOM Elements
        const counterDisplay = document.getElementById('counterDisplay');
        const progressBar = document.getElementById('progressBar');
        const targetPercentage = document.getElementById('targetPercentage');
        const goalBadge = document.getElementById('goalBadge');
        const stepInput = document.getElementById('stepInput');
        const targetInput = document.getElementById('targetInput');
        const historyList = document.getElementById('historyList');
        const emptyHistoryMsg = document.getElementById('emptyHistoryMsg');

        // Buttons
        const incrementBtn = document.getElementById('incrementBtn');
        const decrementBtn = document.getElementById('decrementBtn');
        const resetBtn = document.getElementById('resetBtn');
        const setValBtn = document.getElementById('setValBtn');
        const soundToggleBtn = document.getElementById('soundToggleBtn');
        const soundIcon = document.getElementById('soundIcon');
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeIcon = document.getElementById('themeIcon');
        const shortcutsBtn = document.getElementById('shortcutsBtn');
        const clearHistoryBtn = document.getElementById('clearHistoryBtn');

        // Modals
        const customValModal = document.getElementById('customValModal');
        const customValInput = document.getElementById('customValInput');
        const cancelModalBtn = document.getElementById('cancelModalBtn');
        const saveModalBtn = document.getElementById('saveModalBtn');
        const shortcutsModal = document.getElementById('shortcutsModal');
        const closeShortcutsBtn = document.getElementById('closeShortcutsBtn');

        // Audio Context Synthesizer
        let audioCtx = null;

        function playSound(freq, duration = 0.08) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.warn('Audio playback error:', e);
            }
        }

        function updateUI(action = null) {
            // Display Bump Animation
            counterDisplay.classList.remove('animate-bump');
            void counterDisplay.offsetWidth; // Trigger reflow
            counterDisplay.classList.add('animate-bump');

            counterDisplay.textContent = count.toLocaleString();

            // Calculate progress percentage relative to target
            const percentage = target > 0 ? Math.min(Math.round((count / target) * 100), 100) : 0;
            const clampedPercentage = Math.max(0, percentage);
            progressBar.style.width = `${clampedPercentage}%`;
            targetPercentage.textContent = `${clampedPercentage}%`;

            // Check Goal Reached
            if (count >= target && target > 0) {
                goalBadge.classList.remove('hidden');
            } else {
                goalBadge.classList.add('hidden');
            }

            // Log history if an action occurred
            if (action) {
                logHistory(action, count);
            }
        }

        // History Logging
        function logHistory(action, val) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            
            history.unshift({ action, val, timeStr });
            if (history.length > 20) history.pop();

            renderHistory();
        }

        function renderHistory() {
            if (history.length === 0) {
                emptyHistoryMsg.classList.remove('hidden');
                historyList.innerHTML = '';
                historyList.appendChild(emptyHistoryMsg);
                return;
            }

            emptyHistoryMsg.classList.add('hidden');
            historyList.innerHTML = '';

            history.forEach(item => {
                const el = document.createElement('div');
                el.className = 'flex items-center justify-between p-2 rounded-xl bg-slate-100/70 dark:bg-slate-800/60 border border-slate-200/50 dark:border-slate-700/50';
                
                let iconClass = 'fa-pen';
                let actionColor = 'text-slate-500';

                if (item.action.includes('Increment')) {
                    iconClass = 'fa-plus';
                    actionColor = 'text-emerald-500';
                } else if (item.action.includes('Decrement')) {
                    iconClass = 'fa-minus';
                    actionColor = 'text-rose-500';
                } else if (item.action.includes('Reset')) {
                    iconClass = 'fa-rotate-left';
                    actionColor = 'text-amber-500';
                }

                el.innerHTML = `
                    <div class="flex items-center gap-2">
                        <i class="fa-solid ${iconClass} ${actionColor}"></i>
                        <span class="font-medium text-slate-700 dark:text-slate-300">${item.action}</span>
                    </div>
                    <div class="flex items-center gap-2 text-slate-400">
                        <span class="font-bold text-slate-800 dark:text-slate-200">${item.val}</span>
                        <span>•</span>
                        <span>${item.timeStr}</span>
                    </div>
                `;
                historyList.appendChild(el);
            });
        }

        // Core Actions
        function increment() {
            count += step;
            playSound(523.25); // C5 note
            updateUI(`Increment (+${step})`);
        }

        function decrement() {
            count -= step;
            playSound(392.00); // G4 note
            updateUI(`Decrement (-${step})`);
        }

        function reset() {
            count = 0;
            playSound(329.63); // E4 note
            updateUI('Reset');
        }

        // Event Listeners
        incrementBtn.addEventListener('click', increment);
        decrementBtn.addEventListener('click', decrement);
        resetBtn.addEventListener('click', reset);

        // Inputs
        stepInput.addEventListener('change', (e) => {
            step = Math.max(1, parseInt(e.target.value) || 1);
        });

        targetInput.addEventListener('change', (e) => {
            target = Math.max(1, parseInt(e.target.value) || 1);
            updateUI();
        });

        // Set Custom Value Modal
        setValBtn.addEventListener('click', () => {
            customValInput.value = count;
            customValModal.classList.remove('hidden');
            customValModal.classList.add('flex');
            customValInput.focus();
        });

        cancelModalBtn.addEventListener('click', () => {
            customValModal.classList.add('hidden');
            customValModal.classList.remove('flex');
        });

        saveModalBtn.addEventListener('click', () => {
            const newVal = parseInt(customValInput.value);
            if (!isNaN(newVal)) {
                count = newVal;
                playSound(440);
                updateUI('Set Value');
            }
            customValModal.classList.add('hidden');
            customValModal.classList.remove('flex');
        });

        // Sound Toggle
        soundToggleBtn.addEventListener('click', () => {
            soundEnabled = !soundEnabled;
            if (soundEnabled) {
                soundIcon.className = 'fa-solid fa-volume-high text-base';
                soundToggleBtn.classList.remove('opacity-50');
            } else {
                soundIcon.className = 'fa-solid fa-volume-xmark text-base';
                soundToggleBtn.classList.add('opacity-50');
            }
        });

        // Theme Toggle
        themeToggleBtn.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            themeIcon.className = isDark ? 'fa-solid fa-sun text-base' : 'fa-solid fa-moon text-base';
        });

        // Shortcuts Modal
        shortcutsBtn.addEventListener('click', () => {
            shortcutsModal.classList.remove('hidden');
            shortcutsModal.classList.add('flex');
        });

        closeShortcutsBtn.addEventListener('click', () => {
            shortcutsModal.classList.add('hidden');
            shortcutsModal.classList.remove('flex');
        });

        // Clear History
        clearHistoryBtn.addEventListener('click', () => {
            history = [];
            renderHistory();
        });

        // Keyboard Shortcuts
        window.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT') return; // Ignore typing in input fields
            
            if (e.code === 'Space' || e.code === 'ArrowUp') {
                e.preventDefault();
                increment();
            } else if (e.code === 'ArrowDown') {
                e.preventDefault();
                decrement();
            } else if (e.code === 'KeyR') {
                e.preventDefault();
                reset();
            }
        });

        // Initialize display
        updateUI();
    </script>
</body>
</html>
